{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bundle-never-die",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
